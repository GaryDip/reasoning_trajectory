# Model checkpoints — too large for git; see MODEL_NOTE.md next to each checkpoint dir
**/*.pt
**/*.safetensors

# Hidden-state activation arrays — too large for git; regenerate via hidden_states/extract_hidden_states.py
**/*.npz

# Global retrieval embedding cache — too large for git; regenerate via retrieval/build_embedding_cache.py
retrieval/embedding_cache/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Logs
*.log

# Numpy caches / embedding matrices — regenerate (retrieval/build_global_corpus.py etc.)
**/*.npy
retrieval/global_corpus/

# Large regenerable datasets & candidate-pool caches (each dir's README says how to rebuild)
rerank_listwise_contrastive/data/
rerank_pairwise_mlp/data/
adaptive_lambda_rerank/data/
new_data_recipe/output_full/
error_propagation_probe/data/
error_propagation_probe/hidden_states_full*/
error_propagation_probe/hidden_states_multilayer*/
gate_mtl_shared_backbone/cache/
online_listwise_gate/results/**/feature_cache/
**/target_judge_log.jsonl

# ChainRAG / GRITHopper reproduction: cloned inputs and per-question logs
chainrag/data/*.jsonl
chainrag/processed_data/
chainrag/cache/
grithopper/results/

# Editor
.vscode/

# Third-party reproduction clones — they carry their own .git (see WORK_SUMMARY 1.2)
chainrag/
grithopper/

# Model artifacts of non-adopted variants — their code, logs and metrics are kept
online_listwise_gate/results/**/artifact.joblib

# Per-question case logs: keep only the runs cited in WORK_SUMMARY / THESIS_OUTLINE
# (metrics JSON of every run is always kept; these logs feed the offline analyses:
#  precision comparison, decomposer ablation, significance tests, case studies)
retrieval/results/**/retrieval_cases_*.jsonl
