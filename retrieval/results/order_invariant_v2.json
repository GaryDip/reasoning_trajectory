    "order_invariant_scope": "HotpotQA: all questions; 2Wiki: comparison + bridge_comparison; MuSiQue and 2Wiki compositional/inference stay positional (both protocols coincide there)",
    "per_hop_rule": "para_ids[j] in set(gold_idxs) and para_ids[j] not in para_ids[:j]",
    "chain@1_strict_rule": "len(para_ids) == len(gold_idxs) and para_ids is a permutation of gold_idxs",
    "bridge_comparison": "ORDER_INVARIANT_TASK.md assumed the dedup'd supporting_facts order is branch1's two passages then branch2's; it is NOT -- it is interleaved (branch1 hop1, branch2 hop1, branch1 hop2, branch2 hop2), verified on all 2,751 dev questions against the evidences triples. Per that document's fallback the headline rule is plain permutation-without-reuse; the branch-precedence variant is reported as a diagnostic only.",
    "recall@3": "null where the run's case log predates hop_ranked_para_ids (the B/C feature arms and the 2026-08 ColBERT no-gate runs)"
  },
